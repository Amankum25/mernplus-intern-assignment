# Bybit API Credentials (Testnet or Demo)
# Get Testnet keys from: https://testnet.bybit.com
# Get Demo keys from: https://www.bybit.com (Demo Trading profile)

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Environment: TESTNET, DEMO, or MAINNET
BYBIT_ENVIRONMENT=TESTNET

# Optional: Default trading quantity for BTC options (minimum is 0.01 BTC)
DEFAULT_TRADE_QTY=0.01

# Web Dashboard Port
WEB_PORT=8000

